<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Edit Cycle</title>
    <style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh}.box{background:white;padding:30px;width:400px;border-radius:8px}input,select{width:100%;padding:10px;margin:10px 0}</style>
</head>
<body>
    <div class="box">
        <h2>Edit Performance Cycle</h2>
        <form action="/edit-cycle" method="POST">
            <input type="hidden" name="Cycle_ID" value="<%= cycle.Cycle_ID %>">
            
            <label>Cycle Name</label>
            <input type="text" name="Cycle_Name" value="<%= cycle.Cycle_Name %>" required>
            
            <label>Start Date</label>
            <input type="date" name="Start_Date" value="<%= cycle.Start_Date %>" required>
            
            <label>End Date</label>
            <input type="date" name="End_Date" value="<%= cycle.End_Date %>" required>

            <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;cursor:pointer;">Update Cycle</button>
            <a href="/cycles" style="display:block;text-align:center;margin-top:10px;text-decoration:none;color:#555;">Cancel</a>
        </form>
    </div>
</body>
</html>