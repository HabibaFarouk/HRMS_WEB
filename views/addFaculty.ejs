<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Add Faculty</title>
    <style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh;} .box{background:white;padding:30px;width:400px;border-radius:8px;} input{width:100%;padding:10px;margin:10px 0;}</style>
</head>
<body>
    <div class="box">
        <h2>Add Faculty</h2>
        <form action="/add-faculty" method="POST">
            <label>Faculty Name</label>
            <input type="text" name="Faculty_Name" required>
            <label>Location</label>
            <input type="text" name="Location">
            <label>Email</label>
            <input type="email" name="Contact_Email">
            <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;cursor:pointer;">Save Faculty</button>
        </form>
    </div>
</body></html>