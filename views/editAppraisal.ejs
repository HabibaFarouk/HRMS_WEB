<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Edit Appraisal</title>
    <style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh}.box{background:white;padding:30px;width:400px;border-radius:8px}input,select{width:100%;padding:10px;margin:10px 0}</style>
</head>
<body>
    <div class="box">
        <h2>Edit Appraisal</h2>
        <form action="/edit-appraisal" method="POST">
            <input type="hidden" name="Appraisal_ID" value="<%= appraisal.Appraisal_ID %>">
            
            <label>Appraisal Date</label>
            <input type="date" name="Appraisal_Date" value="<%= appraisal.Appraisal_Date %>" required>
            
            <label>Overall Score</label>
            <input type="number" step="0.01" name="Overall_Score" value="<%= appraisal.Overall_Score %>" required>

            <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;cursor:pointer;">Update Appraisal</button>
            <a href="/appraisals" style="display:block;text-align:center;margin-top:10px;text-decoration:none;color:#555;">Cancel</a>
        </form>
    </div>
</body>
</html>