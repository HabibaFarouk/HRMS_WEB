<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Edit Department</title>
    <style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh}.box{background:white;padding:30px;width:400px;border-radius:8px}input,select{width:100%;padding:10px;margin:10px 0}</style>
</head>
<body>
    <div class="box">
        <h2>Edit Department</h2>
        <form action="/edit-department" method="POST">
            <input type="hidden" name="Department_ID" value="<%= dept.Department_ID %>">
            
            <label>Department Name</label>
            <input type="text" name="Department_Name" value="<%= dept.Department_Name %>" required>
            
            <label>Type</label>
            <select name="Department_Type">
                <option value="Academic" <%= dept.Department_Type=='Academic'?'selected':'' %>>Academic</option>
                <option value="Administrative" <%= dept.Department_Type=='Administrative'?'selected':'' %>>Administrative</option>
            </select>
            
            <label>Location</label>
            <input type="text" name="Location" value="<%= dept.Location %>">

            <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;cursor:pointer;">Update Department</button>
            <a href="/departments" style="display:block;text-align:center;margin-top:10px;text-decoration:none;color:#555;">Cancel</a>
        </form>
    </div>
</body>
</html>