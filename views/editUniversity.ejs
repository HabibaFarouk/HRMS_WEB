<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Edit Uni</title><style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh}.box{background:white;padding:30px;width:400px;border-radius:8px}input{width:100%;padding:10px;margin:10px 0}</style></head><body><div class="box"><h2>Edit University</h2><form action="/edit-university" method="POST"><input type="hidden" name="University_ID" value="<%= uni.University_ID %>"><label>Name</label><input type="text" name="University_Name" value="<%= uni.University_Name %>"><label>Acronym</label><input type="text" name="Acronym" value="<%= uni.Acronym %>"><button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;">Update</button></form></div></body></html>