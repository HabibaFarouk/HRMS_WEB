<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Edit Appeal</title><style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh}.box{background:white;padding:30px;width:400px;border-radius:8px}input,select{width:100%;padding:10px;margin:10px 0}</style></head>
<body>
    <div class="box">
        <h2>Edit Appeal</h2>
        <form action="/edit-appeal" method="POST">
            <input type="hidden" name="Appeal_ID" value="<%= appeal.Appeal_ID %>">
            <label>Reason</label>
            <input type="text" name="Reason" value="<%= appeal.Reason %>" required>
            <label>Status</label>
            <select name="Approval_Status">
                <option value="Pending" <%= appeal.Approval_Status=='Pending'?'selected':'' %>>Pending</option>
                <option value="Approved" <%= appeal.Approval_Status=='Approved'?'selected':'' %>>Approved</option>
                <option value="Rejected" <%= appeal.Approval_Status=='Rejected'?'selected':'' %>>Rejected</option>
            </select>
            <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;">Update Appeal</button>
        </form>
    </div>
</body></html>