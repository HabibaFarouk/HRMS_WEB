<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Assignment</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { font-family: 'Segoe UI', sans-serif; background: #f3f4f6; display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .form-box { background: white; width: 100%; max-width: 500px; padding: 40px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        label { display: block; margin-top: 15px; margin-bottom: 5px; color: #64748b; font-size: 14px; font-weight: 600; }
        input, select { width: 100%; padding: 10px; margin-bottom: 15px; border: 1px solid #e2e8f0; border-radius: 4px; box-sizing: border-box; }
        .btn { width: 100%; padding: 12px; background: #4f46e5; color: white; border: none; border-radius: 4px; cursor: pointer; }
        a { display: block; text-align: center; margin-top: 15px; color: #64748b; text-decoration: none; }
    </style>
</head>
<body>
    <div class="form-box">
        <h2>Edit Job Assignment</h2>
        <form action="/edit-assignment" method="POST">
            <input type="hidden" name="Assignment_ID" value="<%= assign.Assignment_ID %>">

            <label>Employee</label>
            <select name="Employee_ID">
                <% employees.forEach(emp => { %>
                    <option value="<%= emp.Employee_ID %>" <%= assign.Employee_ID === emp.Employee_ID ? 'selected' : '' %>>
                        <%= emp.First_Name %> <%= emp.Last_Name %>
                    </option>
                <% }) %>
            </select>

            <label>Job Title</label>
            <select name="Job_ID">
                <% jobs.forEach(job => { %>
                    <option value="<%= job.Job_ID %>" <%= assign.Job_ID === job.Job_ID ? 'selected' : '' %>>
                        <%= job.Job_Title %>
                    </option>
                <% }) %>
            </select>

            <label>Start Date</label>
            <input type="date" name="Start_Date" value="<%= assign.Start_Date %>">

            <label>End Date</label>
            <input type="date" name="End_Date" value="<%= assign.End_Date %>">

            <label>Status</label>
            <select name="Status">
                <option value="Active" <%= assign.Status === 'Active' ? 'selected' : '' %>>Active</option>
                <option value="Inactive" <%= assign.Status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
            </select>

            <label>Contract ID</label>
            <input type="number" name="Contract_ID" value="<%= assign.Contract_ID || '' %>">

            <button type="submit" class="btn">Update Assignment</button>
            <a href="/assignments">Cancel</a>
        </form>
    </div>
</body>
</html>