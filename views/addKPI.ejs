<!DOCTYPE html><html><body style="font-family:sans-serif;padding:50px;background:#f3f4f6;">
<div style="background:white;padding:30px;width:400px;margin:auto;"><h2>Add KPI</h2>
<form action="/add-kpi" method="POST">
    <label>Name:</label><input type="text" name="KPI_Name" required style="width:100%;margin:10px 0;">
    <label>Unit:</label><input type="text" name="Measurement_Unit" style="width:100%;margin:10px 0;">
    <label>Target:</label><input type="number" name="Target_Value" style="width:100%;margin:10px 0;">
    <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;">Save</button>
</form></div></body></html>