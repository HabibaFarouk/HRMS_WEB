<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><title>Edit Job</title>
    <style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh;} .box{background:white;padding:30px;width:400px;border-radius:8px;} input,select{width:100%;padding:10px;margin:10px 0;}</style>
</head>
<body>
    <div class="box">
        <h2>Edit Job</h2>
        <form action="/edit-job" method="POST">
            <input type="hidden" name="Job_ID" value="<%= job.Job_ID %>">
            <label>Job Title</label>
            <input type="text" name="Job_Title" value="<%= job.Job_Title %>" required>
            <label>Min Salary</label>
            <input type="number" name="Min_Salary" value="<%= job.Min_Salary %>">
            <label>Max Salary</label>
            <input type="number" name="Max_Salary" value="<%= job.Max_Salary %>">
            <label>Level</label>
            <select name="Job_Level">
                <option value="Entry" <%= job.Job_Level=='Entry'?'selected':'' %>>Entry</option>
                <option value="Mid" <%= job.Job_Level=='Mid'?'selected':'' %>>Mid</option>
                <option value="Senior" <%= job.Job_Level=='Senior'?'selected':'' %>>Senior</option>
            </select>
            <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;cursor:pointer;">Update Job</button>
        </form>
    </div>
</body></html>