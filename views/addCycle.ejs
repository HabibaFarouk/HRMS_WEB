<!DOCTYPE html><html><body style="font-family:sans-serif;padding:50px;background:#f3f4f6;">
<div style="background:white;padding:30px;width:400px;margin:auto;"><h2>Add Cycle</h2>
<form action="/add-cycle" method="POST">
    <label>Name:</label><input type="text" name="Cycle_Name" required style="width:100%;margin:10px 0;">
    <label>Start:</label><input type="date" name="Start_Date" required style="width:100%;margin:10px 0;">
    <label>End:</label><input type="date" name="End_Date" required style="width:100%;margin:10px 0;">
    <button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;">Save</button>
</form></div></body></html>