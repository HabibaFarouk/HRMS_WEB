<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Add Contract</title><style>body{font-family:'Segoe UI';background:#f3f4f6;display:flex;justify-content:center;align-items:center;height:100vh}.box{background:white;padding:30px;width:400px;border-radius:8px}input,select{width:100%;padding:10px;margin:10px 0}</style></head><body><div class="box"><h2>Add Contract</h2><form action="/add-contract" method="POST"><label>Type</label><select name="Type"><option>Permanent</option><option>Temporary</option></select><label>Modality</label><select name="Work_Modality"><option>Full Time</option><option>Part Time</option><option>Remote</option></select><label>Duration (Months)</label><input type="number" name="Default_Duration"><button type="submit" style="width:100%;padding:10px;background:#4f46e5;color:white;border:none;">Save</button></form></div></body></html>